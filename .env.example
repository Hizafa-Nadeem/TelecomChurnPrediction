# Copy to .env and edit. .env is git-ignored; this example file is committed.
# Only environment-specific settings and secrets belong here.
# Model and pipeline parameters (seed, split, Optuna trials, business costs) live in configs/params.yaml.
# Read with pydantic-settings (src/churn/config.py).

# --- General ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Data ------------------------------------------------------------------
# Folder holding raw/, interim/ and processed/ (mirrors the Azure Blob layout)
DATA_DIR=data

# --- MLflow (Phase 1: local SQLite store) -----------------------------------
# In Phase 2 this becomes the Azure ML workspace tracking URI
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=telecom-churn
MLFLOW_MODEL_NAME=churn-catboost

# --- API (FastAPI, local) ----------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Azure demo (Phase 2 only; leave blank in Phase 1) ------------------------
# Sign in with `az login`; no passwords or keys are stored here.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-churn-dev
AZURE_WORKSPACE_NAME=
AZURE_LOCATION=
AZURE_ONLINE_ENDPOINT_NAME=churn-endpoint
# Only if the demo endpoint uses key auth (secret: never commit a real value)
AZURE_ENDPOINT_KEY=
